{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --legacy-peer-deps && npm run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production npm start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100
  }
}
